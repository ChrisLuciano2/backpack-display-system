[Unit]
Description=Backpack server (Bluetooth commands and the mode manager)
Documentation=https://github.com/ChrisLuciano2/backpack-display-system
After=default.target bluetooth.target

[Service]
Type=simple
WorkingDirectory=@REPO@
EnvironmentFile=-%h/.config/backpack/secrets.env
# Give the desktop session a few seconds to come up.
ExecStartPre=/bin/sleep 6
ExecStart=@NODE@ @REPO@/server/index.js
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=120
StartLimitBurst=5
StandardOutput=append:%h/backpack.log
StandardError=append:%h/backpack.log

[Install]
WantedBy=default.target
